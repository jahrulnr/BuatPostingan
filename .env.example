# BuatPostingan / webchat env
#
# Most product knobs now live in storage/config.json (JSON source of truth).
# Copy storage/config.example.json → storage/config.json and edit there.
# Env below is the bootstrap: kept only for process-level paths / addr /
# retry-status list / stub toggle. See docs/architecture/settings-config.md.

# Process / paths (env-only — not in config.json)
BP_HTTP_ADDR=:8080
BP_WEB_ROOT=web
BP_STORAGE_ROOT=storage/webchat
BP_DOCS_ROOT=docs/webchat
BP_PROMPTS_ROOT=resources/webchat/prompts
BP_TOOLS_ROOT=resources/webchat/tools

# Optional override for JSON settings (default: dirname(BP_STORAGE_ROOT)/config.json → storage/config.json)
# BP_CONFIG_PATH=storage/config.json

# LLM bootstrap toggles (env-only)
# Retry statuses are a fixed operational policy — kept in env (not JSON).
BP_LLM_RETRY_STATUSES=408,409,413,425,429,500,502,503,504
# Default: true when no provider API key is set (ready-to-use stub turns).
# Set BP_LLM_STUB=false and configure providers in storage/config.json for real LLM.
BP_LLM_STUB=false
