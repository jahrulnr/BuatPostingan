# BuatPostingan / webchat env
# Copy to .env and adjust. Product prefix: BP_* only.

BP_HTTP_ADDR=:8080
BP_WEB_ROOT=web
BP_STORAGE_ROOT=storage/webchat
BP_DOCS_ROOT=docs/webchat
BP_PROMPTS_ROOT=resources/webchat/prompts
BP_TOOLS_ROOT=resources/webchat/tools

BP_MAX_TOOL_ROUNDS=8
BP_SPEAK_FLOOR_TTL_SEC=600
BP_LOCK_TTL_SEC=300
BP_TURN_RATE_LIMIT_PER_MIN=10
BP_TURN_JOB_TIMEOUT_SEC=120

# Default: true when no provider API key is set (ready-to-use stub turns).
# Set BP_LLM_STUB=false and provide keys for real LLM.
# BP_LLM_STUB=true

BP_LLM_STRATEGY=failover
BP_LLM_PROVIDERS=OPENROUTER
BP_LLM_TOTAL_ATTEMPT_BUDGET=4
BP_LLM_CIRCUIT_FAILURE_THRESHOLD=3
BP_LLM_CIRCUIT_COOLDOWN_SEC=60
BP_LLM_RETRY_STATUSES=408,409,413,425,429,500,502,503,504

# LLM HTTP streaming (default true). false → stream:false + Accept application/json.
# If stream=true is rejected as unsupported, client retries once with stream=false.
# BP_LLM_STREAM=true

# Multimodal vision pixels on user turns (default auto).
# auto = probe OpenRouter /models input_modalities (+ heuristics); on = always; off = metadata only.
# BP_LLM_VISION=auto

# Reasoning effort / thinking budget (default auto).
# auto = probe /models reasoning + supported_parameters; send default_effort only when supported.
# Explicit: none|minimal|low|medium|high|xhigh|max — applied only when model supports effort.
# BP_LLM_EFFORT=auto

# Example OpenRouter / OpenAI-compatible proxy. Uncomment + set key for real turns.
# API=responses (default recommendation; mirrors AIPedia) or API=chat.
# With BP_LLM_STREAM=true (default), client requests stream=true and parses text/event-stream;
# application/json non-stream responses remain supported; unsupported-stream errors auto-fallback.
# BP_LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# BP_LLM_OPENROUTER_API_KEY=
# BP_LLM_OPENROUTER_MODEL=openai/gpt-4o-mini
# BP_LLM_OPENROUTER_API=responses
# BP_LLM_OPENROUTER_TIMEOUT_SEC=60
# BP_LLM_OPENROUTER_MAX_ATTEMPTS=1
# BP_LLM_OPENROUTER_ENABLED=true

# Context compaction (optional; stub path skips this)
BP_CONTEXT_COMPACTION_ENABLED=false

BP_DOCS_TOP_K=5
BP_DOCS_MIN_SCORE=0.5
BP_DOCS_FUZZY_ENABLED=true
BP_DOCS_APP_ID=buatpostingan

# Optional: GitHub search rate limit for web_search (searchwire). Not required for default metasearch.
# Also accepts GITHUB_TOKEN if BP_GITHUB_TOKEN is unset.
# BP_GITHUB_TOKEN=
